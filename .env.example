# ============================================
# Xuong VinFast Phuc Loi - Cau hinh he thong
# Copy file nay thanh .env va dien gia tri
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Telegram Bot ---
# Tao bot qua @BotFather tren Telegram, lay token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Public server origin, de tu dong dang ky webhook. De trong = khong dang ky.
# VD: https://your-app.onrender.com
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
ADMIN_API_KEY=your_admin_api_key

# --- Supabase (PostgreSQL: source of truth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_server_service_role_key

# --- Google Sheets ---
# ID cua Google Sheet (lay tu URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=your_google_sheet_id

# Credentials dang JSON string (Service Account)
# Cach lay: Google Cloud Console > IAM > Service Accounts > Keys > JSON
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your_project","private_key":"your_private_key","client_email":"your_service_account"}

# --- Poe-compatible plate extraction ---
POE_API_KEY=your_poe_api_key
POE_OCR_MODEL=GPT-4o-mini
# POE_API_ENDPOINT=https://api.poe.com/v1/chat/completions

# --- Nguong OCR ---
OCR_CONFIDENCE_HIGH=0.8
OCR_CONFIDENCE_MEDIUM=0.5

# Toi thieu bao nhieu phut moi coi anh tiep theo la xe ra (app default: 3)
MIN_WORKSHOP_MINUTES=3

# --- Nguong canh bao thoi gian luu (gio) ---
# Qua 24h -> Muc uu tien = "Canh bao"
ALERT_HOURS_WARNING=24
# Qua 48h -> Muc uu tien = "Khan"
ALERT_HOURS_URGENT=48

# --- Quan ly ---
# Telegram chat ID cua quan ly (nhan thong bao canh bao + bao cao)
# Nhieu ID cach nhau bang dau phay. De trong = khong gui thong bao.
# Cach lay chat ID: gui /start cho @userinfobot tren Telegram
MANAGER_CHAT_IDS=

# Gio gui bao cao tong hop tu dong (0-23, mac dinh: 18 = 6PM)
DAILY_REPORT_HOUR=18

# --- Timezone ---
TIMEZONE=Asia/Ho_Chi_Minh
